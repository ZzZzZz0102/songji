HOST=127.0.0.1
PORT=8787
# Set the public HTTPS origin when deploying. Secure cookies are enabled for HTTPS.
APP_ORIGIN=http://127.0.0.1:8787
DATA_DIR=./data
# Optional, OpenAI-compatible chat completion service. Never put keys in public/.
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=doubao-seed-2-1-pro-260915
# 0 keeps the per-user limit only. The temporary public launcher defaults to 100.
LLM_MAX_CALLS_PER_24H=0
# Enable only for the local Cloudflare tunnel proxy; the public launcher sets it.
TRUST_CLOUDFLARE_PROXY=0
# Optional email/notification relay. Requests contain a booking ID, not personal data.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
